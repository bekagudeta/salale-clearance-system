# Dependencies (installed inside the image)
vendor
node_modules

# Local env / secrets (provided via Railway variables)
.env
.env.*

# Build artifacts (rebuilt inside the image)
public/build
public/hot

# Runtime/persistent storage (lives on the Railway volume, not the image)
storage/app/public/*
storage/app/private/*
storage/app/backups/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

# Misc
